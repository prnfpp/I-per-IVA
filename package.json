{
  "name": "i-per-iva",
  "private": true,
  "version": "0.1.0",
  "description": "Pianificazione fiscale e patrimoniale per partite IVA italiane. Locale, modulare, senza server.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run dev -w @iperiva/web",
    "build": "npm run build -w @iperiva/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
